

# ── Gemini API (primary LLM provider) ────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemma 4 model ID on the Gemini API (OpenAI-compatible endpoint).
# Default: gemma-4-26b-a4b-it
# Alternative: gemma-4-31b-it
# IMPORTANT: Re-verify the exact string at aistudio.google.com before first use.
GEMINI_GEMMA_MODEL=gemma-4-26b-a4b-it

# Gemini Embedding model. ALWAYS pass output_dimensionality=768 on every call.
# The schema stores vector(768); mixing models or dimensions will corrupt data.
GEMINI_EMBED_MODEL=gemini-embedding-001

# ── OpenRouter (fallback LLM provider) ───────────────────────────────────────
# Get from https://openrouter.ai/keys  — add a few dollars so the paid fallback works.
OPENROUTER_API_KEY=

# Paid fallback (preferred over :free)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it

# Last-resort free fallback (may be slower, rate-limited)
OPENROUTER_MODEL_FREE=google/gemma-4-26b-a4b-it:free

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from https://supabase.com/dashboard → Project Settings → API
# SUPABASE_SERVICE_ROLE_KEY is BACKEND-ONLY. Never expose it to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google APIs ───────────────────────────────────────────────────────────────
# Places API (New) — server-side only; optional (OpenStreetMap fallback active if empty).
GOOGLE_PLACES_API_KEY=

# ── Frontend URL (CORS on Render) ─────────────────────────────────────────────
# Set to your deployed Vercel domain (e.g. https://healthmate-compass.vercel.app)
FRONTEND_URL=

# ── Frontend (Vite VITE_ prefix — these ARE bundled into the browser build) ──
# Maps JS API — restrict by HTTP referrer (your Vercel domain + localhost).
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Supabase anon key (safe to expose; RLS enforces data isolation).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# FastAPI backend URL (e.g. http://localhost:8000 locally, or your Render URL)
VITE_API_BASE_URL=http://localhost:8000
